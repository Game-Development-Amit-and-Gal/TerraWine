  panel3: {fileID: 914478088}
  tutorialText3: {fileID: 914478087}
  arrow3: {fileID: 914478089}
  gotItButton3: {fileID: 914478086}
  overrideGotItPosition: 0
  gotItAnchoredPosPanel1: {x: 0, y: 0}
  gotItAnchoredPosPanel2: {x: 0, y: 0}
  gotItAnchoredPosPanel3: {x: 0, y: 0}
  guides:
  - sceneName: SampleScene
    panelChoice: 0
    steps:
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "\"Hey, wake up, kiddo.\r\nI heard someone stole our secret family
        recipe\u2026\r\nBut don't panic.\n\r\nA recipe is only the beginning.\r\nWhat
        really matters is you, your taste,\r\nand the choices you make in this vineyard.\r\n\r\nTogether,
        we\u2019ll build a new legend \u2013 your own wine.\"\r\n\r\nBefore anything
        else, let me show you how to play.\r\nPress Next to learn how the vineyard
        works.\r\n"
      targetObjectName: 
      arrowOffset: {x: 0, y: 0}
      hideSceneUI: 1
      overridePanelChoice: 0
      panelChoice: 0
      nextMode: 0
      secondsToAutoNext: 2
      requiredFlagName: 
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: 'To move around the farm,

        use the movement controls

        arrow
        keys.'
      targetObjectName: Player
      arrowOffset: {x: -257, y: -213}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 3
      secondsToAutoNext: 4
      requiredFlagName: Move arrow keys
      allowMovementDuringThisStep: 1
    - hideUiPaths:
      - GameUI/Shop
      - GameUI/Calendar
      - GameUI/World
      showUiPaths: []
      hideWorldPaths:
      - Grid/WineryHouse/WineryDoorTrigger
      showWorldPaths: []
      message: "This is your bag.\r\n\r\nHere you can see your seeds, grapes and
        other resources.\r\nYou will use these items to plant, harvest and make wine.\r\n\r\nLater,
        we\u2019ll use the bag to choose which seeds to plant."
      targetObjectName: BAG
      arrowOffset: {x: -220, y: -50}
      hideSceneUI: 0
      overridePanelChoice: 0
      panelChoice: 0
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Bag Open
      allowMovementDuringThisStep: 0
    - hideUiPaths:
      - GameUI/Shop
      - GameUI/Calendar
      - GameUI/World
      showUiPaths: []
      hideWorldPaths:
      - Grid/WineryHouse/WineryDoorTrigger
      showWorldPaths: []
      message: "Now it\u2019s time \nto plant some seeds.\nIn the vineyard, \nclick
        on one of the seeds."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 250}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Press Seed
      allowMovementDuringThisStep: 0
    - hideUiPaths:
      - GameUI/Shop
      - GameUI/Calendar
      - GameUI/World
      showUiPaths: []
      hideWorldPaths:
      - Grid/WineryHouse/WineryDoorTrigger
      showWorldPaths: []
      message: "Click on one of the vineyard \nplots to plant the seed.\nYou can
        use the arrow keys to move \ncloser to the vineyard plots."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Press vineyard
      allowMovementDuringThisStep: 1
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "we need to wait for the \ngrapes to grow.\n\nTo see how much time
        is left, \nhover your mouse over the \nvineyard plot."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
