--- !u!114 &238639773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 238639771}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 287b752c5c056d84e8250115ffced93e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  panel: {fileID: 35155697}
  tutorialText: {fileID: 763222774}
  arrow: {fileID: 1289897165}
  gotItButton: {fileID: 8698948}
  panel2: {fileID: 394271075}
  tutorialText2: {fileID: 1518040411}
  arrow2: {fileID: 527368224}
  gotItButton2: {fileID: 292720817}
  overrideGotItPosition: 0
  gotItAnchoredPosPanel1: {x: 0, y: 0}
  gotItAnchoredPosPanel2: {x: 0, y: 0}
  guides:
  - sceneName: SampleScene
    panelChoice: 0
    steps:
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "\"Hey, wake up, kiddo.\r\nI heard someone stole our secret family
        recipe\u2026\r\nBut don't panic.\n\r\nA recipe is only the beginning.\r\nWhat
        really matters is you, your taste,\r\nand the choices you make in this vineyard.\r\n\r\nTogether,
        we\u2019ll build a new legend \u2013 your own wine.\"\r\n\r\nBefore anything
        else, let me show you how to play.\r\nPress Next to learn how the vineyard
        works.\r\n"
      targetObjectName: 
      arrowOffset: {x: 0, y: 0}
      hideSceneUI: 1
      overridePanelChoice: 0
      panelChoice: 0
      nextMode: 0
      secondsToAutoNext: 2
      requiredFlagName: 
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: 'To move around the farm,

        use the movement controls

        arrow
        keys.'
      targetObjectName: Player
      arrowOffset: {x: -257, y: -213}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 3
      secondsToAutoNext: 4
      requiredFlagName: Move arrow keys
      allowMovementDuringThisStep: 1
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "This is your bag.\r\n\r\nHere you can see your seeds, grapes and
        other resources.\r\nYou will use these items to plant, harvest and make wine.\r\n\r\nLater,
        we\u2019ll use the bag to choose which seeds to plant."
      targetObjectName: BAG
      arrowOffset: {x: -220, y: -50}
      hideSceneUI: 0
      overridePanelChoice: 0
      panelChoice: 0
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Bag Open
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "Now it\u2019s time \nto plant some seeds.\nIn the vineyard, \nclick
        on one of the seeds."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Press Seed
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "Click on one of the vineyard \nplots to plant the seed.\nYou can
        use the arrow keys to move \ncloser to the vineyard plots."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Press vineyard
      allowMovementDuringThisStep: 1
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "we need to wait for the \ngrapes to grow.\n\nTo see how much time
        is left, \nhover your mouse over the \nvineyard plot."
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Vineyard Redy
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: 'The grapes are ready

        press to harvest them.'
      targetObjectName: Player
      arrowOffset: {x: -900, y: 200}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Is Ready
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Click on your bag to see the grapes inside it.
      targetObjectName: BAG
      arrowOffset: {x: -220, y: -50}
      hideSceneUI: 0
      overridePanelChoice: 0
      panelChoice: 0
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Bag Open
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Press ESC to close the bag.
      targetObjectName: Player
      arrowOffset: {x: 0, y: 200}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Bag Close
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Enter the winery
      targetObjectName: Player
      arrowOffset: {x: -1050, y: -500}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 2
      requiredFlagName: Winery
      allowMovementDuringThisStep: 1
  - sceneName: WineryReception
    panelChoice: 0
    steps:
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "Go to the Basement \nusing the arrow keys."
      targetObjectName: Player
      arrowOffset: {x: 800, y: -400}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: Basement
      allowMovementDuringThisStep: 1
  - sceneName: Basement
    panelChoice: 0
    steps:
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: "Go to the right door \nusing the arrow keys."
      targetObjectName: Player
      arrowOffset: {x: 200, y: 200}
      hideSceneUI: 1
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: Right door
      allowMovementDuringThisStep: 1
  - sceneName: wine
    panelChoice: 0
    steps:
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Press the barrel
      targetObjectName: Player
      arrowOffset: {x: 900, y: 100}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: barrel
      allowMovementDuringThisStep: 1
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Press the Young Cabernet
      targetObjectName: Player
      arrowOffset: {x: 200, y: 400}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: Young Cabernet
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Press confirm
      targetObjectName: Player
      arrowOffset: {x: 200, y: 400}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: confirm
      allowMovementDuringThisStep: 0
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Preparing Wine,Standby...
      targetObjectName: Player
      arrowOffset: {x: 900, y: 100}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 2
      secondsToAutoNext: 0
      requiredFlagName: barrel
      allowMovementDuringThisStep: 1
    - hideUiPaths: []
      showUiPaths: []
      hideWorldPaths: []
      showWorldPaths: []
      message: Go back to the yard.
      targetObjectName: Player
      arrowOffset: {x: 900, y: 100}
      hideSceneUI: 0
      overridePanelChoice: 1
      panelChoice: 1
      nextMode: 0
      secondsToAutoNext: 0
      requiredFlagName: 
      allowMovementDuringThisStep: 0
  sceneUiRootName: UI
  worldRootName: World
